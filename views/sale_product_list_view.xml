<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    for sale procuts submenu capacity view form-->
     <record id="sale_config_capacity_list_view" model="ir.ui.view">
        <field name="name">sales.config.product.capacity.list</field>
        <field name="model">product.capacity</field>
        <field name="arch" type="xml">
            <list string="Capacity" editable="bottom" sample="1">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_sale_config_capacity_list" model="ir.actions.act_window">
            <field name="name">Capacity</field>
            <field name="res_model">product.capacity</field>
            <field name="view_id" ref="sale_config_capacity_list_view"/>
           <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create Capacity
            </p><p>
            Use Tags to manage and track your Opportunities (product structure, sales type, ...)
            </p>
        </field>
    </record>

