<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_view_order_form_fixed_tax" model="ir.ui.view">
        <field name="name">inherit.sale.order.form.fixed.tax</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[@name='order_lines']//field[@name='order_line']//list//field[@name='tax_id']" position="after">
                <field name="warranty_id"  />
            </xpath>
        </field>
    </record>
</odoo>
